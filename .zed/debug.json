[
  {
    "label": "API (fastapi dev)",
    "adapter": "Debugpy",
    "request": "launch",
    "module": "fastapi",
    "args": ["dev"],
    "cwd": "$ZED_WORKTREE_ROOT/backend",
    "python": "$ZED_WORKTREE_ROOT/backend/.venv/Scripts/python.exe"
  },
  {
    "label": "Scraper",
    "adapter": "Debugpy",
    "request": "launch",
    "module": "app.scraper.run",
    "cwd": "$ZED_WORKTREE_ROOT/backend",
    "python": "$ZED_WORKTREE_ROOT/backend/.venv/Scripts/python.exe"
  },
  {
    "label": "Tests (pytest)",
    "adapter": "Debugpy",
    "request": "launch",
    "module": "pytest",
    "cwd": "$ZED_WORKTREE_ROOT/backend",
    "python": "$ZED_WORKTREE_ROOT/backend/.venv/Scripts/python.exe"
  }
]
