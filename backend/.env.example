# Copy to .env; real environment variables take precedence

# Any Postgres works. For Supabase: Connect -> Session pooler (5432), or Transaction
# pooler (6543) for Lambda, then swap the scheme to postgresql+psycopg:// and
# URL-encode special characters in the password
PT_DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Bearer token for /api and /mcp, at least 32 characters. Generate one with
# uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
PT_API_TOKEN=
