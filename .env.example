# Copy to .env; real environment variables take precedence

# Any Postgres works. For Supabase: Connect -> Session pooler, then swap the scheme
# to postgresql+psycopg:// and URL-encode special characters in the password
PT_DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Point at a synced folder (OneDrive, Dropbox...) to share data between machines
# PT_DATA_DIR=app/data
