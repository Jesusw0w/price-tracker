      "boundElements": [],
      "updated": 1791128864810,
      "link": null,
      "locked": false,
      "text": "Local worker\n  poll refresh requests (every minute)\n  scheduled full refresh (every N hours)\n  retries with backoff; mark failed\n\nAWS daily Lambda (EventBridge)\n  flag trackers with no price in 48 h\n  (broken URL, product discontinued)\n  later: target-price alerts (SES/SNS)",
      "originalText": "Local worker\n  poll refresh requests (every minute)\n  scheduled full refresh (every N hours)\n  retries with backoff; mark failed\n\nAWS daily Lambda (EventBridge)\n  flag trackers with no price in 48 h\n  (broken URL, product discontinued)\n  later: target-price alerts (SES/SNS)",
      "fontSize": 13,
      "fontFamily": 5,
      "textAlign": "left",
