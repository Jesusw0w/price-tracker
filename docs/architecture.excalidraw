    {
      "id": "a3_97_4668",
      "type": "text",
      "x": 0,
      "y": 4120,
      "width": 475.20000000000005,
      "height": 22.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
