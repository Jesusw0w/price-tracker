   "updated": 1791500000000,
   "link": null,
   "locked": false,
   "text": "auth: GET login, GET callback, POST logout\nme: GET /api/me, PUT /api/me/settings\nmembers (owner): GET, POST, PATCH /{sub}\nproducts: GET, GET /archived, POST\nproducts/{id}: PATCH, PUT /link, DELETE",
   "originalText": "auth: GET login, GET callback, POST logout\nme: GET /api/me, PUT /api/me/settings\nmembers (owner): GET, POST, PATCH /{sub}\nproducts: GET, GET /archived, POST\nproducts/{id}: PATCH, PUT /link, DELETE",
   "fontSize": 15,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
